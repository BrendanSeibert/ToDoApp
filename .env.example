# Copy this file to .env and adjust values as needed before running docker compose.

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
# Host ports (change if these conflict with something else already running)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Backend
# Any long random string; keys the hashes of session tokens stored in Neo4j. Changing it invalidates all sessions.
SESSION_SECRET=please-change-me-too
BACKEND_PORT=3001
# Must match the origin the browser loads the frontend from, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
# Base URL the frontend's browser code uses to reach the backend API.
VITE_API_URL=http://localhost:3001
