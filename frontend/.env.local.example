# Copy this file to .env.local and adjust values as needed before running the frontend locally with `npm run dev`.
# Not used by docker compose; the Docker build takes VITE_API_URL from the root .env instead.

# Base URL the frontend's browser code uses to reach the backend API.
# Must match the backend's host port (BACKEND_PORT in the root .env, default 3001).
VITE_API_URL=http://localhost:3001
